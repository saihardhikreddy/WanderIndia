# WanderIndia Application Environment Configuration

# Flask Session Security Key: any long random string, e.g. from
#   python -c "import secrets; print(secrets.token_hex(32))"
# (the app refuses this placeholder and uses a random key per run instead)
FLASK_SECRET_KEY=wanderindia_super_secret_key_placeholder

# Google OAuth Client ID
GOOGLE_CLIENT_ID=your-google-oauth-client-id-here

# Unsplash API Access Key (for destination landscape photos)
UNSPLASH_ACCESS_KEY=your-unsplash-access-key-here

# Geoapify API Key (for route scanning & maps)
GEOAPIFY_KEY=your-geoapify-key-here

# Groq LLM API Key (Required for AI itinerary generation - supports Llama 3.3 70B)
GROQ_API_KEY=gsk_your_groq_api_key_here
